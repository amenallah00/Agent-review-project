# --- GitHub App (US 1.1) ---
GITHUB_APP_ID=123456
GITHUB_PRIVATE_KEY_PATH=./secrets/github-app-private-key.pem
# GITHUB_PRIVATE_KEY=          # alternative : contenu PEM direct (utilisé en prod/Azure, prioritaire sur le chemin ci-dessus)
GITHUB_WEBHOOK_SECRET=change-me-to-a-long-random-string

# --- Fournisseur LLM (section 3 du cahier des charges) ---
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
# ⚠️ Les fournisseurs retirent régulièrement leurs anciens modèles (ex: claude-3-5-sonnet-20241022
# a été retiré le 5 janvier 2026). Si vous obtenez une erreur 400/404 à l'appel du LLM, vérifiez
# d'abord le nom de modèle ci-dessus sur la documentation officielle du fournisseur.

# --- Azure OpenAI Service (alternative si LLM_PROVIDER=azure_openai) ---
# Utile si votre organisation a déjà un abonnement Azure et que vous préférez
# éviter la facturation directe OpenAI/Anthropic — même modèle GPT-4o, juste
# hébergé sur Azure. Créer la ressource "Azure OpenAI" dans le portail Azure,
# puis déployer un modèle (ex: gpt-4o) pour obtenir ces 3 valeurs.
AZURE_OPENAI_ENDPOINT=https://votre-ressource.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=gpt-4o
AZURE_OPENAI_API_VERSION=2024-08-01-preview

# --- Garde-fou de coûts (US 4.2) ---
MAX_PR_LINES=500

# --- Garde-fou anti rate-limit GitHub (AAR-32 [RISQUE]) ---
MAX_COMMENTS_PER_REVIEW=15

# --- Garde-fou anti-hallucination LLM (AAR-33 [RISQUE]) ---
MIN_ISSUE_CONFIDENCE=medium

# --- Garde-fou de coûts sur les gros diffs multi-fichiers (AAR-34 [RISQUE]) ---
MAX_CHUNKS_PER_REVIEW=8

# --- Tableau de bord : base de données, session, OAuth GitHub ---
# SQLite par défaut (dev local) ; en production, utiliser une URL PostgreSQL
# (ex: postgresql+psycopg2://user:pass@host:5432/dbname).
DATABASE_URL=sqlite:///./codesentinel.db
# Clé de signature des jetons de session (JWT). Générez-en une avec :
# python -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=change-me-to-a-long-random-string
# Créez une "OAuth App" (pas une GitHub App) sur https://github.com/settings/developers
# Callback URL à déclarer : <votre-domaine>/auth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Laissez vide pour utiliser automatiquement <host de la requête>/auth/callback
GITHUB_OAUTH_REDIRECT_URI=
# Origine du tableau de bord, utilisée pour la redirection post-OAuth
FRONTEND_URL=http://localhost:8000
# Nombre de revues gratuites par compte non-administrateur avant blocage (US 4.2 bis)
FREE_TIER_REVIEW_LIMIT=50

